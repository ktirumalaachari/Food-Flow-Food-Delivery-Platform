# ==============================================================================
# Food Flow (Client) — Environment Configuration Template
# ==============================================================================
# Copy this file to `Client/.env` or `Client/.env.local` and fill in your keys.

# Database Connection (MongoDB Atlas)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="food-delivery-platform"

# Authentication (Better Auth & JWT)
BETTER_AUTH_SECRET="your_32_character_cryptographically_secure_secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Backend Server URLs
NEXT_PUBLIC_SERVER_BASE_URL="http://localhost:5000"
NEXT_PUBLIC_SERVER_URL="http://localhost:5000"
NEXT_PUBLIC_SERVER_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
JWT_SECRET="your_32_character_jwt_secret_matching_server"

# Google OAuth 2.0 (Optional Social Login)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ImgBB Image Hosting
IMGBB_API_KEY="your_imgbb_api_key"
NEXT_PUBLIC_IMGBB_API_KEY="your_imgbb_api_key"

# Razorpay Online Payment Gateway
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Email Services (Resend / SendGrid / SMTP Fallback)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="onboarding@resend.dev"
SENDGRID_API_KEY="SG.your_sendgrid_api_key"
SENDGRID_FROM_EMAIL="foodflow.support@gmail.com"

# SMTP (Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="foodflow.support@gmail.com"
SMTP_PASS="your_16_digit_app_password"
EMAIL_FROM="Food Flow <foodflow.support@gmail.com>"

# AI Services (Google Gemini + Groq / OpenRouter)
GEMINI_API_KEY="your_google_gemini_api_key"
GROQ_API_KEY="gsk_your_groq_api_key"
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_api_key"
OPENROUTER_MODEL="deepseek/deepseek-chat"
OPENROUTER_SITE_URL="http://localhost:3000"

# Web Push Notifications (PWA VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:foodflow.support@gmail.com"
